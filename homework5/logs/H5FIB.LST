				; AX = n, returns DS:SI pointing to its 21 litt
				le-endian decimal digits. 
				; BX, DI, CX, DX are preserved. AX, SI and flag
				s are volatile. 
 007A				FIB PROC NEAR 
 007A  53			    PUSH BX 
 007B  57			    PUSH DI 
 007C  51			    PUSH CX 
 007D  52			    PUSH DX 
 007E  8B D8			    MOV BX,AX 
 0080  B9 0015			    MOV CX,21 
 0083  F7 E1			    MUL CX 
 0085  8B F8			    MOV DI,AX 
 0087  8D BD 0102 R		    LEA DI,CACHE[DI] 
 008B  80 BF 009D R 00		    CMP BYTE PTR READY[BX],0 
 0090  75 38			    JNE FIB_DONE 
 0092  8B C3			    MOV AX,BX 
 0094  48			    DEC AX 
