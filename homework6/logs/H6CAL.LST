 0000				GET_DAYS PROC FAR 
 0000  50			    PUSH AX 
 0001  53			    PUSH BX 
 0002  A1 0000 R		    MOV AX,YEAR 
 0005  8B 1E 0002 R		    MOV BX,MONTH 
 0009  E8 005F R		    CALL MONTH_DAYS 
