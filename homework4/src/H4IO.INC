; Output a DOS character in DL; preserve AX.
PUT_CHAR PROC NEAR
    PUSH AX
    MOV AH,02H
    INT 21H
    POP AX
    RET
PUT_CHAR ENDP

; Output AX in decimal; preserve AX, BX, CX and DX.
PRINT_DEC PROC NEAR
    PUSH AX
    PUSH BX
    PUSH CX
    PUSH DX
    MOV BX,10
    XOR CX,CX
PD_DIVIDE:
    XOR DX,DX
    DIV BX
    PUSH DX
    INC CX
    OR AX,AX
    JNZ PD_DIVIDE
PD_WRITE:
    POP DX
    ADD DL,'0'
    CALL PUT_CHAR
    LOOP PD_WRITE
    POP DX
    POP CX
    POP BX
    POP AX
    RET
PRINT_DEC ENDP

NEWLINE PROC NEAR
    PUSH DX
    MOV DL,13
    CALL PUT_CHAR
    MOV DL,10
    CALL PUT_CHAR
    POP DX
    RET
NEWLINE ENDP
